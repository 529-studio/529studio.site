---
import type { Locale } from '../i18n/translations';
import { translations } from '../i18n/translations';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = translations[lang].telemetry;
---

<section id="telemetry" class="py-16 md:py-20 border-b border-[#1a2233]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
      <div>
        <div class="text-xs font-bold uppercase tracking-wider mono text-[#22c55e] mb-2">
          {t.tag}
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
          {t.title}
        </h2>
      </div>
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-[#0d111a] border border-[#1a2233] text-xs mono text-[#9ca3af]">
        <span class="w-2 h-2 rounded-full bg-[#22c55e] animate-ping"></span>
        <span>{t.status}</span>
      </div>
    </div>

    <!-- Telemetry Card -->
    <div class="bg-[#0d111a] border border-[#1a2233] rounded-xl p-6 sm:p-8 shadow-xl">
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 sm:gap-6 pb-6 border-b border-[#1a2233]">
        <div class="bg-[#111622]/50 border border-[#1a2233] rounded-lg p-4">
          <div class="text-2xl sm:text-3xl font-bold mono text-white tracking-tight">35.8K+</div>
          <div class="text-[11px] font-semibold text-[#9ca3af] uppercase tracking-wider mt-1">{t.totalRequests}</div>
        </div>

        <div class="bg-[#111622]/50 border border-[#1a2233] rounded-lg p-4">
          <div class="text-2xl sm:text-3xl font-bold mono text-[#22c55e] tracking-tight">3.0K+</div>
          <div class="text-[11px] font-semibold text-[#9ca3af] uppercase tracking-wider mt-1">{t.threatsMitigated}</div>
        </div>

        <div class="bg-[#111622]/50 border border-[#1a2233] rounded-lg p-4">
          <div class="text-2xl sm:text-3xl font-bold mono text-white tracking-tight">160+ MB</div>
          <div class="text-[11px] font-semibold text-[#9ca3af] uppercase tracking-wider mt-1">{t.edgeBandwidth}</div>
        </div>

        <div class="bg-[#111622]/50 border border-[#1a2233] rounded-lg p-4">
          <div class="text-2xl sm:text-3xl font-bold mono text-white tracking-tight">5 Repos</div>
          <div class="text-[11px] font-semibold text-[#9ca3af] uppercase tracking-wider mt-1">{t.publicRepos}</div>
        </div>

        <div class="bg-[#111622]/50 border border-[#1a2233] rounded-lg p-4">
          <div class="text-2xl sm:text-3xl font-bold mono text-[#38bdf8] tracking-tight">HTTP/3</div>
          <div class="text-[11px] font-semibold text-[#9ca3af] uppercase tracking-wider mt-1">{t.networkProtocol}</div>
        </div>

        <div class="bg-[#111622]/50 border border-[#1a2233] rounded-lg p-4">
          <div class="text-2xl sm:text-3xl font-bold mono text-[#22c55e] tracking-tight">&lt; 15ms</div>
          <div class="text-[11px] font-semibold text-[#9ca3af] uppercase tracking-wider mt-1">{t.edgeLatency}</div>
        </div>
      </div>

      <!-- Live Metadata Footer -->
      <div class="pt-6 flex flex-wrap items-center justify-between gap-4 text-xs mono text-[#9ca3af]">
        <div class="flex items-center gap-6 flex-wrap">
          <span><strong class="text-white">{t.ingress}</strong></span>
          <span>•</span>
          <span><strong class="text-white">{t.popRouting}</strong></span>
          <span>•</span>
          <span><strong class="text-white">{t.encryption}</strong></span>
        </div>
        <div class="text-[#22c55e]">
          ● {t.edgeProxied}
        </div>
      </div>
    </div>
  </div>
</section>
