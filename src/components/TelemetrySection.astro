---
import type { Locale } from '../i18n/translations';
import { translations } from '../i18n/translations';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = translations[lang].specs;
---

<section id="specs" class="py-20 md:py-28 hairline-b bg-black">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-16">
      <div>
        <div class="text-xs font-mono uppercase tracking-widest text-[#888888] mb-3">
          {t.tag}
        </div>
        <h2 class="text-2xl sm:text-4xl font-bold tracking-tight text-[#ededed] mb-3">
          {t.title}
        </h2>
        <p class="text-xs sm:text-sm text-[#888888] max-w-xl">
          {t.subtitle}
        </p>
      </div>

      <div class="inline-flex items-center gap-2 px-3 py-1 rounded text-xs mono text-[#10b981] bg-[#10b981]/10 border border-[#10b981]/20 self-start sm:self-auto">
        <span class="w-1.5 h-1.5 rounded-full bg-[#10b981]"></span>
        <span>ALL SYSTEMS NOMINAL</span>
      </div>
    </div>

    <!-- Readout Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-[#1e1e1e] border border-[#1e1e1e] rounded-xl overflow-hidden">
      {t.readouts.map((item) => (
        <div class="bg-[#080808] p-6 hover:bg-[#0c0c0c] smooth-trans flex flex-col justify-between">
          <div class="text-[10px] mono uppercase tracking-wider text-[#666666] mb-2">
            {item.label}
          </div>
          <div>
            <div class="text-xl sm:text-2xl font-bold mono text-[#ededed] tracking-tight mb-1">
              {item.val}
            </div>
            <div class="text-xs text-[#777777] mono">
              {item.note}
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
