---
import type { Locale } from '../i18n/translations';
import { translations } from '../i18n/translations';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = translations[lang].hero;
---

<section class="relative pt-20 pb-20 md:pt-28 md:pb-28 hairline-b bg-black">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center flex flex-col items-center">
    
    <!-- Brand Icon Avatar -->
    <div class="mb-6 relative group">
      <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl overflow-hidden border border-[#222222] shadow-2xl bg-[#0a0a0a] p-1">
        <img
          src="/529studioicon3.png"
          alt="529 Studio - Indie Engineering Lab"
          class="w-full h-full object-cover rounded-xl"
          width="96"
          height="96"
          loading="eager"
        />
      </div>
    </div>

    <!-- Status Badge -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs mono text-[#888888] bg-[#0d0d0d] border border-[#1e1e1e] mb-8">
      <span class="w-1.5 h-1.5 rounded-full bg-[#10b981]"></span>
      <span>{t.badge}</span>
    </div>

    <!-- Main Heading -->
    <h1 class="text-3xl sm:text-5xl md:text-6xl font-bold tracking-tight text-[#ededed] mb-6 leading-[1.12]">
      {t.titleLine1} <br class="hidden sm:inline" />
      <span class="text-[#ffffff]">{t.titleLine2}</span>
    </h1>

    <!-- Manifesto Paragraph -->
    <p class="max-w-2xl text-base sm:text-lg text-[#888888] leading-relaxed mb-10 text-balance font-normal">
      {t.manifesto}
    </p>

    <!-- Call to Actions -->
    <div class="flex flex-wrap items-center justify-center gap-3">
      <a
        href="#works"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-xs font-semibold bg-[#ededed] text-black hover:bg-white smooth-trans cursor-pointer"
      >
        <span>{t.ctaExplore}</span>
        <span>↓</span>
      </a>
      
      <a
        href="https://github.com/529-studio"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-xs mono text-[#888888] hover:text-[#ededed] bg-[#0a0a0a] border border-[#1e1e1e] hover:border-[#333333] smooth-trans cursor-pointer"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
        <span>{t.ctaGithub}</span>
      </a>

      <a
        href="mailto:contact@529studio.site"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-xs mono text-[#666666] hover:text-[#888888] smooth-trans cursor-pointer"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        <span>{t.ctaContact}</span>
      </a>
    </div>

  </div>
</section>
