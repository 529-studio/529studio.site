---
import type { Locale } from '../i18n/translations';
import { translations } from '../i18n/translations';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = translations[lang].hero;
---

<section class="relative pt-20 pb-16 md:pt-28 md:pb-24 grid-background border-b border-[#1a2233]">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center">
    <!-- Status Badge -->
    <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full text-xs font-semibold mono bg-[#22c55e]/10 border border-[#22c55e]/30 text-[#22c55e] mb-8">
      <span class="w-2 h-2 rounded-full bg-[#22c55e] shadow-[0_0_8px_#22c55e] animate-pulse"></span>
      {t.badge}
    </div>

    <!-- Main Heading -->
    <h1 class="text-3xl sm:text-5xl md:text-6xl font-black tracking-tight text-white mb-6 leading-[1.1]">
      {t.titleLine1}<br class="hidden sm:inline" />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-[#e2e8f0] to-[#94a3b8]">
        {t.titleLine2}
      </span>
    </h1>

    <!-- Subtitle -->
    <p class="max-w-3xl mx-auto text-base sm:text-lg text-[#9ca3af] leading-relaxed mb-10">
      {t.subtitle}
    </p>

    <!-- Call to Actions -->
    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="#projects"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-lg text-sm font-semibold bg-white text-black hover:bg-[#e5e7eb] transition-all shadow-md group"
      >
        <span>{t.ctaExplore}</span>
        <span class="group-hover:translate-x-0.5 transition-transform">➔</span>
      </a>
      <a
        href="https://github.com/529-studio"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-lg text-sm font-semibold mono bg-[#111622] text-white border border-[#2a354d] hover:border-[#22c55e] hover:bg-[#161c2b] transition-all"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
        <span>{t.ctaGithub}</span>
      </a>
      <a
        href="mailto:contact@529studio.site"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-lg text-sm font-semibold mono bg-[#0d111a] text-[#9ca3af] border border-[#1a2233] hover:text-white hover:border-[#2a354d] transition-all"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        <span>{t.ctaEmail}</span>
      </a>
    </div>
  </div>
</section>
