---
import type { Locale } from '../i18n/translations';
import { translations } from '../i18n/translations';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = translations[lang].team;
---

<section id="engineers" class="py-20 md:py-28 hairline-b bg-black">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="mb-16 md:mb-20">
      <div class="text-xs font-mono uppercase tracking-widest text-[#888888] mb-3">
        {t.tag}
      </div>
      <h2 class="text-2xl sm:text-4xl font-bold tracking-tight text-[#ededed] mb-4">
        {t.title}
      </h2>
      <p class="text-sm sm:text-base text-[#888888] max-w-2xl leading-relaxed">
        {t.subtitle}
      </p>
    </div>

    <!-- 2 Engineers Profiles -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10">
      {t.members.map((member) => (
        <article class="hairline-border bg-[#080808] rounded-xl p-6 sm:p-8 flex flex-col justify-between hover:border-[#2e2e2e] smooth-trans">
          <div>
            <!-- Header: Avatar + Meta -->
            <div class="flex items-start justify-between gap-4 mb-6 pb-6 border-b border-[#1a1a1a]">
              <div class="flex items-center gap-3.5">
                <div class="relative w-12 h-12 rounded-xl overflow-hidden bg-[#111111] border border-[#222222] shrink-0">
                  <img
                    src={member.avatar}
                    alt={member.name}
                    class="w-full h-full object-cover"
                    loading="lazy"
                    onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                  />
                  <div class="hidden absolute inset-0 w-full h-full items-center justify-center bg-[#111111] text-[#ededed] font-bold mono text-sm select-none">
                    {member.initials}
                  </div>
                </div>

                <div>
                  <h3 class="text-lg sm:text-xl font-bold text-[#ededed] tracking-tight">
                    {member.name}
                  </h3>
                  <div class="text-xs mono text-[#777777] mt-0.5">{member.handle}</div>
                  <div class="text-[11px] mono text-[#10b981] mt-1">{member.role}</div>
                </div>
              </div>

              <!-- GitHub Profile Link -->
              <a
                href={member.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded text-xs mono text-[#888888] hover:text-[#ededed] bg-[#0d0d0d] border border-[#1e1e1e] hover:border-[#333333] smooth-trans"
                aria-label={`${member.name} on GitHub`}
              >
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
                <span>GitHub ↗</span>
              </a>
            </div>

            <!-- Summary Statement -->
            <p class="text-xs sm:text-sm text-[#888888] leading-relaxed mb-6 font-normal">
              {member.summary}
            </p>

            <!-- Key Engineering Contributions -->
            <div class="space-y-2.5 mb-8">
              <div class="text-[10px] mono uppercase tracking-wider text-[#555555]">
                Key Contributions
              </div>
              {member.points.map((pt) => (
                <div class="text-xs text-[#777777] leading-relaxed flex items-start gap-2">
                  <span class="text-[#444444] mt-0.5">•</span>
                  <span>{pt}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Tech Stack Line -->
          <div class="pt-4 border-t border-[#1a1a1a] text-[11px] mono text-[#666666]">
            {member.stackString}
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
