---

<header class="sticky top-0 z-50 backdrop-blur-md bg-[#07090e]/80 border-b border-[#1a2233]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Brand -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-8 h-8 rounded-lg bg-[#111622] border border-[#2a354d] flex items-center justify-center font-bold text-white mono text-sm group-hover:border-[#22c55e] transition-colors">
        529
      </div>
      <div class="flex flex-col">
        <span class="font-extrabold tracking-tight text-white text-base leading-none">529 Studio</span>
        <span class="text-[10px] text-[#9ca3af] mono uppercase tracking-wider mt-1">Autonomous Systems</span>
      </div>
    </a>

    <!-- Navigation Links -->
    <nav class="hidden md:flex items-center gap-6 text-sm text-[#9ca3af]">
      <a href="#projects" class="hover:text-white transition-colors">Projects</a>
      <a href="#team" class="hover:text-white transition-colors">Team</a>
      <a href="#telemetry" class="hover:text-white transition-colors">Edge Telemetry</a>
      <a href="#stack" class="hover:text-white transition-colors">Tech Radar</a>
    </nav>

    <!-- Right Actions -->
    <div class="flex items-center gap-3">
      <div class="hidden sm:inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium mono bg-[#22c55e]/10 border border-[#22c55e]/30 text-[#22c55e]">
        <span class="w-2 h-2 rounded-full bg-[#22c55e] animate-pulse"></span>
        LIVE EDGE
      </div>
      <a
        href="https://github.com/529-studio"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-semibold bg-white text-black hover:bg-[#e5e7eb] transition-all shadow-sm"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
        <span>GitHub</span>
      </a>
    </div>
  </div>
</header>
