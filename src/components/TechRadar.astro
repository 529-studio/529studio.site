---
import type { Locale } from '../i18n/translations';
import { translations } from '../i18n/translations';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = translations[lang].radar;
---

<section id="radar" class="py-20 md:py-28 hairline-b bg-black">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="mb-16">
      <div class="text-xs font-mono uppercase tracking-widest text-[#888888] mb-3">
        {t.tag}
      </div>
      <h2 class="text-2xl sm:text-4xl font-bold tracking-tight text-[#ededed]">
        {t.title}
      </h2>
    </div>

    <!-- 4 Domains Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {t.domains.map((domain) => (
        <div class="hairline-border bg-[#080808] rounded-xl p-6 hover:border-[#2e2e2e] smooth-trans flex flex-col justify-between">
          <div>
            <div class="text-xs mono text-[#555555] mb-3">
              [{domain.num}]
            </div>
            <h3 class="text-base font-bold text-[#ededed] mb-4">
              {domain.name}
            </h3>
          </div>
          <ul class="text-xs mono space-y-2 text-[#777777] border-t border-[#1a1a1a] pt-4">
            {domain.items.map((item) => (
              <li class="flex items-center gap-2">
                <span class="text-[#444444]">•</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

  </div>
</section>
