---
import type { Locale } from '../i18n/translations';
import { translations } from '../i18n/translations';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = translations[lang].radar;
---

<section id="stack" class="py-16 md:py-24 border-b border-[#1a2233]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="mb-12">
      <div class="text-xs font-bold uppercase tracking-wider mono text-[#22c55e] mb-2">
        {t.tag}
      </div>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">
        {t.title}
      </h2>
      <p class="text-base text-[#9ca3af] max-w-2xl">
        {t.subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {t.domains.map((domain) => (
        <div class="bg-[#0d111a] border border-[#1a2233] rounded-xl p-6 flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-lg bg-[#111622] border border-[#2a354d] flex items-center justify-center font-bold text-[#38bdf8] mono text-sm mb-4">
              {domain.num}
            </div>
            <h3 class="text-lg font-bold text-white mb-2">{domain.name}</h3>
            <p class="text-xs text-[#9ca3af] leading-relaxed mb-4">
              {domain.desc}
            </p>
          </div>
          <ul class="text-xs mono space-y-2 text-[#cbd5e1] border-t border-[#1a2233] pt-4">
            {domain.items.map((item) => (
              <li class="flex items-center gap-2">
                <span>•</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
