---
import type { Locale } from '../i18n/translations';
import { translations } from '../i18n/translations';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = translations[lang].projects;
---

<section id="works" class="py-20 md:py-28 hairline-b bg-black">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="mb-16 md:mb-20">
      <div class="text-xs font-mono uppercase tracking-widest text-[#888888] mb-3">
        {t.tag}
      </div>
      <h2 class="text-2xl sm:text-4xl font-bold tracking-tight text-[#ededed] mb-4">
        {t.title}
      </h2>
      <p class="text-sm sm:text-base text-[#888888] max-w-2xl leading-relaxed">
        {t.subtitle}
      </p>
    </div>

    <!-- Flagship Projects -->
    <div class="space-y-24 md:space-y-32">
      {t.items.map((project, index) => {
        const isReversed = index % 2 === 1;
        
        return (
          <article 
            class="hairline-border bg-[#080808] rounded-xl p-6 sm:p-8 md:p-10 relative"
            data-project-id={project.id}
          >
            <!-- Meta Bar -->
            <div class="flex items-center justify-between gap-4 border-b border-[#1a1a1a] pb-4 mb-8 text-xs mono">
              <div class="flex items-center gap-2 text-[#777777]">
                <span class="text-[#ededed] font-medium">{project.category}</span>
                <span>/</span>
                <span>{project.subCategory}</span>
              </div>
              <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-[10px] text-[#10b981] bg-[#10b981]/10 border border-[#10b981]/20">
                <span class="w-1 h-1 rounded-full bg-[#10b981]"></span>
                <span>{project.status}</span>
              </div>
            </div>

            <!-- Content + Gallery Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
              
              <!-- Left: Specs & Details -->
              <div class={`lg:col-span-5 flex flex-col justify-between ${isReversed ? 'lg:order-2' : 'lg:order-1'}`}>
                <div>
                  <h3 class="text-xl sm:text-2xl font-bold text-[#ededed] tracking-tight leading-snug mb-4">
                    {project.title}
                  </h3>

                  <p class="text-xs sm:text-sm text-[#888888] leading-relaxed mb-8">
                    {project.description}
                  </p>

                  <!-- Technical Specifications List -->
                  <div class="space-y-3 mb-8 border-t border-b border-[#1a1a1a] py-5">
                    <div class="text-[10px] mono uppercase tracking-wider text-[#555555]">
                      {t.specsLabel}
                    </div>
                    {project.specs.map((spec) => (
                      <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 text-xs mono">
                        <span class="text-[#777777]">{spec.label}</span>
                        <span class="text-[#ededed] font-medium sm:text-right">{spec.val}</span>
                      </div>
                    ))}
                  </div>

                  <!-- Stack Badges -->
                  <div class="flex flex-wrap gap-1.5 mb-8">
                    {project.stack.map((tech) => (
                      <span class="px-2 py-0.5 rounded text-[11px] mono text-[#888888] bg-[#0f0f0f] border border-[#1e1e1e]">
                        {tech}
                      </span>
                    ))}
                  </div>
                </div>

                <!-- CTA -->
                <div>
                  <a
                    href={project.ctaUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 px-4 py-2 rounded text-xs font-semibold mono bg-[#ededed] text-black hover:bg-white smooth-trans cursor-pointer"
                  >
                    <span>{project.ctaText}</span>
                    <span>↗</span>
                  </a>
                </div>
              </div>

              <!-- Right: Interactive Media Exhibit -->
              <div class={`lg:col-span-7 ${isReversed ? 'lg:order-1' : 'lg:order-2'}`}>
                <div class="gallery-container bg-[#050505] rounded-lg border border-[#1c1c1c] overflow-hidden p-3 sm:p-4">
                  
                  <!-- Tab Bar -->
                  <div class="flex items-center gap-1.5 mb-3 overflow-x-auto pb-1 text-xs mono border-b border-[#1c1c1c]">
                    {project.gallery.map((view, vIdx) => (
                      <button
                        type="button"
                        class={`tab-btn px-2.5 py-1 rounded text-xs transition-colors cursor-pointer ${
                          vIdx === 0 
                            ? 'bg-[#181818] text-[#ededed] border border-[#2e2e2e]' 
                            : 'text-[#666666] hover:text-[#aaaaaa] border border-transparent'
                        }`}
                        data-target={`view-${project.id}-${vIdx}`}
                      >
                        {view.title}
                      </button>
                    ))}
                  </div>

                  <!-- Image Displays -->
                  <div class="relative bg-black rounded border border-[#181818] overflow-hidden">
                    {project.gallery.map((view, vIdx) => {
                      const isMobile = view.id === 'mobile-kiosk';
                      return (
                        <div
                          id={`view-${project.id}-${vIdx}`}
                          class={`gallery-panel ${vIdx === 0 ? 'block' : 'hidden'} transition-opacity duration-200`}
                        >
                          <div class="w-full h-[300px] sm:h-[380px] md:h-[440px] flex items-center justify-center bg-black/80 p-2 sm:p-4">
                            <img
                              src={view.src}
                              alt={`${project.title} - ${view.title}`}
                              class={`max-h-full max-w-full object-contain ${
                                isMobile 
                                  ? 'h-full w-auto rounded-xl border border-[#262626] shadow-2xl shadow-black/80' 
                                  : 'w-full h-full object-contain rounded'
                              }`}
                              loading="lazy"
                            />
                          </div>
                          <div class="p-3 bg-[#0a0a0a] border-t border-[#181818] flex items-center justify-between text-xs mono text-[#888888]">
                            <span>{view.desc}</span>
                            <span class="text-[10px] text-[#555555] shrink-0 ml-2">[{view.badge}]</span>
                          </div>
                        </div>
                      );
                    })}
                  </div>

                </div>
              </div>

            </div>
          </article>
        );
      })}
    </div>

    <!-- Distributed Systems Matrix -->
    <div id="systems" class="mt-28 md:mt-36 pt-16 border-t border-[#1a1a1a]">
      <div class="mb-12">
        <div class="text-xs font-mono uppercase tracking-widest text-[#888888] mb-3">
          {t.otherSystemsTag}
        </div>
        <h3 class="text-xl sm:text-3xl font-bold tracking-tight text-[#ededed] mb-3">
          {t.otherSystemsTitle}
        </h3>
        <p class="text-xs sm:text-sm text-[#888888] max-w-2xl leading-relaxed">
          {t.otherSystemsSubtitle}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {t.systems.map((sys) => (
          <div class="hairline-border bg-[#080808] hover:bg-[#0c0c0c] hover:border-[#333333] smooth-trans rounded-xl p-6 flex flex-col justify-between">
            <div>
              <div class="text-[10px] mono uppercase tracking-wider text-[#666666] mb-2">
                {sys.tag}
              </div>
              <h4 class="text-base font-bold text-[#ededed] tracking-tight mb-3">
                {sys.title}
              </h4>
              <p class="text-xs text-[#888888] leading-relaxed mb-6">
                {sys.description}
              </p>

              <!-- Highlights -->
              <ul class="space-y-1.5 mb-6 text-xs mono text-[#777777]">
                {sys.highlights.map((h) => (
                  <li class="flex items-center gap-2">
                    <span class="text-[#444444]">•</span>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="pt-4 border-t border-[#1a1a1a] flex items-center justify-between">
              <div class="flex flex-wrap gap-1">
                {sys.stack.slice(0, 3).map((st) => (
                  <span class="text-[10px] mono text-[#555555]">
                    {st}
                  </span>
                ))}
              </div>
              {sys.isProtected ? (
                <span class="text-[11px] mono text-[#666666]">
                  {sys.linkText}
                </span>
              ) : (
                <a
                  href={sys.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[11px] mono text-[#ededed] hover:underline"
                >
                  {sys.linkText}
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<script>
  // Pure lightweight vanilla JS tab switching (Zero bloat)
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.gallery-container').forEach((container) => {
      const buttons = container.querySelectorAll('.tab-btn');
      const panels = container.querySelectorAll('.gallery-panel');

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const targetId = btn.getAttribute('data-target');
          if (!targetId) return;

          // Update buttons state
          buttons.forEach((b) => {
            b.classList.remove('bg-[#181818]', 'text-[#ededed]', 'border-[#2e2e2e]');
            b.classList.add('text-[#666666]', 'border-transparent');
          });
          btn.classList.add('bg-[#181818]', 'text-[#ededed]', 'border-[#2e2e2e]');
          btn.classList.remove('text-[#666666]', 'border-transparent');

          // Switch panels
          panels.forEach((panel) => {
            if (panel.id === targetId) {
              panel.classList.remove('hidden');
              panel.classList.add('block');
            } else {
              panel.classList.add('hidden');
              panel.classList.remove('block');
            }
          });
        });
      });
    });
  });
</script>
