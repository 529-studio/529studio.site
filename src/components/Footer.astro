---
import type { Locale } from '../i18n/translations';
import { translations } from '../i18n/translations';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = translations[lang].footer;
---

<footer class="py-12 bg-[#05070a] border-t border-[#1a2233]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 pb-8 border-b border-[#1a2233]">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-[#111622] border border-[#2a354d] flex items-center justify-center font-bold text-white mono text-sm">
          529
        </div>
        <div>
          <div class="font-extrabold text-white text-base tracking-tight">{t.brand}</div>
          <div class="text-xs text-[#9ca3af]">{t.tagline}</div>
        </div>
      </div>

      <div class="flex items-center gap-6 text-xs mono text-[#9ca3af] flex-wrap">
        <a href="https://github.com/529-studio" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
          {t.orgLink}
        </a>
        <a href="mailto:contact@529studio.site" class="hover:text-white transition-colors">
          contact@529studio.site
        </a>
        <a href="https://github.com/thdat-vu" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
          @thdat-vu ↗
        </a>
        <a href="https://github.com/giangdq202" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
          @giangdq202 ↗
        </a>
      </div>
    </div>

    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#6b7280] mono">
      <div>
        {t.copyright}
      </div>
      <div class="flex items-center gap-2 text-[#9ca3af]">
        <span>{t.edgeHosted}</span>
        <span>•</span>
        <span>{t.zeroNat}</span>
      </div>
    </div>
  </div>
</footer>
